# Frontend (Vite)
# Supabase project URL (e.g. https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# MetaMask Embedded Wallets (Web3Auth)
# Client ID from Web3Auth Dashboard (https://dashboard.web3auth.io)
VITE_WEB3AUTH_CLIENT_ID=
# Network: 'devnet' (default, supports localhost) or 'mainnet' (production)
VITE_WEB3AUTH_NETWORK=devnet

# Backend & Door-Staff Verification
# Shared HMAC secret for signing and verifying stateless door-staff links
# Also configure this in Supabase Dashboard (Settings > Edge Functions > Secrets)
STAFF_LINK_SECRET=

# Edge Functions Secrets (Supabase Dashboard: Settings > Edge Functions > Secrets)
# - STAFF_LINK_SECRET: same shared HMAC secret as above
# - WEB3AUTH_CLIENT_ID: same client ID as VITE_WEB3AUTH_CLIENT_ID for token verification in /functions/v1/me

# Optional: Supabase service role key (only for local backend administration scripts)
SUPABASE_SERVICE_ROLE_KEY=

# Network & RPC (Base Sepolia Testnet - Chain ID 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532

# Deployed Passmark ERC-721 Contract Address (Base Sepolia)
PASSMARK_CONTRACT_ADDRESS=0x256c1A87b79f28de3989cBf1742144E3Ca21705C

# Deployer / Platform Admin (Hardhat Keystore recommended; NEVER commit actual keys)
# Set via: npx hardhat keystore set DEPLOYER_PRIVATE_KEY
DEPLOYER_PRIVATE_KEY=

# Basescan / Etherscan API Key for contract verification
# Set via: npx hardhat keystore set BASESCAN_API_KEY
BASESCAN_API_KEY=
