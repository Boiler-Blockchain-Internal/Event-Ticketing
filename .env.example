# Frontend (Vite)
# Supabase project URL (e.g. https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Backend & Door-Staff Verification
# Shared HMAC secret for signing and verifying stateless door-staff links
# Also configure this in Supabase Dashboard (Settings > Edge Functions > Secrets)
STAFF_LINK_SECRET=

# Optional: Supabase service role key (only for local backend administration scripts)
SUPABASE_SERVICE_ROLE_KEY=
